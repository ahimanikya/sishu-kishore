rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){return request.auth != null && request.auth.token.email_verified == true;}
  function editor(){return signedIn() && request.auth.token.editor == true;}
  function validText(v,max){return v is string && v.size()>0 && v.size()<=max;}
  function validSubmission(d){
   return d.keys().hasAll(['owner','name','contact','kind','title','body','page','status','consent','createdAt','updatedAt'])
    && d.keys().hasOnly(['owner','name','contact','kind','title','body','page','status','consent','createdAt','updatedAt'])
    && validText(d.name,120) && validText(d.contact,254) && validText(d.title,240) && validText(d.body,60000)
    && d.page is string && d.page.size()<=300 && d.kind in ['article','comment','contact','book']
    && (d.kind != 'comment' || d.body.size()<=2000)
    && d.consent == 'editorial-review-v1';
  }
  function validQuota(path,d,max){
   return d.count is int && d.count>=1 && d.count<=max && d.at==request.time
    && ((!exists(path) || !get(path).data.keys().hasAll(['startedAt','count']) || get(path).data.startedAt<=request.time-duration.value(1,'h'))
      ? (d.count==1 && d.startedAt==request.time)
      : (d.count==get(path).data.count+1 && d.startedAt==get(path).data.startedAt));
  }
  function throttle(){return /databases/$(database)/documents/submissionLimits/$(request.auth.uid);}
  match /submissions/{id} {
   allow create: if signedIn() && validSubmission(request.resource.data)
    && request.resource.data.owner == request.auth.uid
    && request.resource.data.contact == request.auth.token.email
    && request.resource.data.status == 'received'
    && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
    && getAfter(throttle()).data.id == id && getAfter(throttle()).data.at == request.time
    && (!exists(throttle()) || get(throttle()).data.at < request.time-duration.value(60,'s'));
   allow read: if editor() || (signedIn() && resource.data.owner==request.auth.uid);
   allow update: if editor() && validSubmission(request.resource.data)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
    && request.resource.data.status in ['received','reviewing','approved','rejected']
    && request.resource.data.updatedAt==request.time;
   allow delete: if false;
  }
  match /submissionLimits/{uid} {
   allow create, update: if signedIn() && uid==request.auth.uid
    && request.resource.data.keys().hasOnly(['id','at','startedAt','count'])
    && request.resource.data.id is string && request.resource.data.id.matches('^[a-zA-Z0-9]{20}$')
    && validQuota(throttle(),request.resource.data,10)
    && !exists(/databases/$(database)/documents/submissions/$(request.resource.data.id))
    && getAfter(/databases/$(database)/documents/submissions/$(request.resource.data.id)).data.owner==request.auth.uid;
   allow read: if signedIn() && (uid==request.auth.uid || editor());
  }
  function validDraft(d){return d.keys().hasAll(['kind','title','body','byline','issue','page','image','sourceId','updatedAt'])
   && d.keys().hasOnly(['kind','title','body','byline','issue','page','image','sourceId','updatedAt'])
   && d.kind in ['article','comment','book'] && validText(d.title,240) && validText(d.body,60000)
   && validText(d.byline,120) && d.issue is string && d.issue.size()<=300
   && d.page is string && d.page.size()<=300
   && d.image is string && d.image.matches('^/(art|media|social)/[a-zA-Z0-9_./-]+$')
   && d.sourceId is string && d.sourceId.size()<=100 && d.updatedAt==request.time;}
  match /drafts/{id} {allow read,delete:if editor(); allow create,update:if editor() && validDraft(request.resource.data);}
  match /publications/{id} {
   allow get: if editor() || resource.data.state == 'published';
   allow list: if editor() || (request.query.limit != null && request.query.limit<=100 && resource.data.state == 'published');
   allow create,update: if editor()
    && request.resource.data.keys().hasAll(['kind','title','body','byline','issue','page','image','state','publishedAt'])
    && request.resource.data.keys().hasOnly(['kind','title','body','byline','issue','page','image','state','publishedAt'])
    && request.resource.data.kind in ['article','comment','book']
    && validText(request.resource.data.title,240) && validText(request.resource.data.body,60000)
    && validText(request.resource.data.byline,120)
    && request.resource.data.issue is string && request.resource.data.issue.size()<=300
    && request.resource.data.page is string && request.resource.data.page.size()<=300
    && request.resource.data.image is string && request.resource.data.image.matches('^/(art|media|social)/[a-zA-Z0-9_./-]+$')
    && request.resource.data.state in ['published','withdrawn'] && request.resource.data.publishedAt==request.time;
   allow delete: if false;
  }
  function engagementLimit(){return /databases/$(database)/documents/engagementLimits/$(request.auth.uid);}
  match /engagementLimits/{uid} {
   allow get: if signedIn() && uid==request.auth.uid;
   allow create,update: if signedIn() && uid==request.auth.uid
    && request.resource.data.keys().hasOnly(['article','at','startedAt','count'])
    && request.resource.data.article is string && request.resource.data.article.matches('^[a-zA-Z0-9_-]{1,100}$')
    && validQuota(engagementLimit(),request.resource.data,60)
    && (!exists(engagementLimit()) || resource.data.at<request.time-duration.value(2,'s'))
    && getAfter(/databases/$(database)/documents/articleLikes/$(request.resource.data.article)).data.count != (exists(/databases/$(database)/documents/articleLikes/$(request.resource.data.article)) ? get(/databases/$(database)/documents/articleLikes/$(request.resource.data.article)).data.count : 0);
  }
  function likePath(article,uid){return /databases/$(database)/documents/articleLikes/$(article)/readers/$(uid);}
  function countPath(article){return /databases/$(database)/documents/articleLikes/$(article);}
  match /articleLikes/{article} {
   allow get: if true;
   allow create,update: if signedIn() && article.matches('^[a-zA-Z0-9_-]{1,100}$')
    && getAfter(engagementLimit()).data.article==article && getAfter(engagementLimit()).data.at==request.time
    && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count is int
    && request.resource.data.count >= 0
    && ((!exists(likePath(article,request.auth.uid)) && existsAfter(likePath(article,request.auth.uid))
      && request.resource.data.count == (exists(countPath(article)) ? resource.data.count : 0)+1)
     || (exists(likePath(article,request.auth.uid)) && !existsAfter(likePath(article,request.auth.uid))
      && request.resource.data.count == resource.data.count-1));
   match /readers/{uid} {
    allow get: if signedIn() && uid==request.auth.uid;
    allow create: if signedIn() && uid==request.auth.uid
     && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at==request.time
     && getAfter(countPath(article)).data.count == (exists(countPath(article)) ? get(countPath(article)).data.count : 0)+1;
    allow delete: if signedIn() && uid==request.auth.uid
     && getAfter(countPath(article)).data.count == get(countPath(article)).data.count-1;
   }
  }
  match /{document=**} {allow read,write:if false;}
 }
}
